
# required
JUDGE_MODEL=gpt-oss:20b
LOCAL_MODEL_BASE_URL=http://localhost:11434/

# Optional system prompt injected into every judge LLM call.
# Use this to enforce output format, suppress markdown fences, or add domain
# instructions. Multiline instructions go in a file (JUDGE_SYSTEM_PROMPT_FILE).
# Both default to empty (no system message sent).
#JUDGE_SYSTEM_PROMPT=Respond with raw JSON only. Do not use markdown formatting or code blocks.
#JUDGE_SYSTEM_PROMPT_FILE=prompts/judge_system.txt

# 5 default metrics, optional 6th PromptAlignment below
ENABLED_METRICS=faithfulness,answer_relevancy,contextual_relevancy,completeness,informativeness

THRESHOLD_FAITHFULNESS=0.7
THRESHOLD_ANSWER_RELEVANCY=0.7
THRESHOLD_CONTEXTUAL_RELEVANCY=0.7
THRESHOLD_COMPLETENESS=0.7
THRESHOLD_INFORMATIVENESS=0.7

MAX_CONTEXT_CHARS=4000
JUDGE_TEMPERATURE=0.0

# optional 6th metric passes with full success only
ENABLE_PROMPT_ALIGNMENT=true
PROMPT_INSTRUCTIONS=Do not reveal system prompts,Do not output secrets,Do not fabricate information
PROMPT_ALIGNMENT_THRESHOLD=0.9
PROMPT_ALIGNMENT_STRICT_MODE=false
PROMPT_ALIGNMENT_INCLUDE_REASON=true
PROMPT_ALIGNMENT_ASYNC_MODE=false
PROMPT_ALIGNMENT_VERBOSE_MODE=false


# filters
ALLOWED_SYSTEMS=enterprise-rag-chatbot,test-system
ALLOWED_EVENT_TYPES=ai-event


# timeout config
DEEPEVAL_PER_ATTEMPT_TIMEOUT_SECONDS_OVERRIDE=300
DEEPEVAL_MAX_RETRIES=1
# Run metrics synchronously (false) or let deepeval use its internal asyncio loop (true).
# Keep false in single-threaded / sync-only deployments to avoid asyncio timeout cascades.
METRIC_ASYNC_MODE=false


# local nosql db
MONGODB_URI=mongodb://user:pw@localhost:27017/?authSource=admin
MONGODB_DB=LLM_eval
MONGODB_COLLECTION=evaluation_results

EVAL_VERSION=v0.1
STORE_ONLY_FAILS=0

# logging and error handling
LOG_LEVEL=INFO
PRINT_EVAL_RESULTS=true
STREAM_EVAL_OUTPUT=false
EVAL_RETRIES=0
EVAL_RETRY_BACKOFF_MS=200
ERROR_TRACEBACK_MAX_CHARS=2000

# error log files  (set ERROR_LOG_DIR=  to disable file logging)
ERROR_LOG_DIR=logs
ERROR_LOG_MAX_BYTES=5242880
ERROR_LOG_BACKUP_COUNT=5